# 复制为 .env 后填写；程序会自动读取，已有环境变量优先。
# 支持引号，不做 ${VAR} 展开，密钥里的 $ 保持原样。

# ===== Telegram 凭据（必须填写） =====
# 在 https://my.telegram.org → API development tools 获取。
# 申请时用你的 Telegram 账号；运行时登录的是 bot，不需要用户账号验证码。
TG_API_ID=12345678
TG_API_HASH=replace_with_your_api_hash
# 在 @BotFather 创建机器人后获得。
TG_BOT_TOKEN=replace_with_your_bot_token
# 仅管理这些群；逗号分隔的数字群 ID。超级群一般以 -100 开头。
TG_CHAT_IDS=-1001234567890
# 可选：首次启动时，通过公开群用户名获取该群的 access_hash。
# 键必须是上方 TG_CHAT_IDS 中的数字 ID；值为对应公开群的 @用户名。
# 示例：TG_CHAT_REFERENCES='{"-1001234567890":"@your_public_group"}'
# 私有群保持 {}：启动后在目标群发 /start@你的机器人用户名，程序取得更新后自动继续。
TG_CHAT_REFERENCES={}

# ===== OpenAI compatible 服务（必须填写） =====
# 填 API 根地址，程序会追加 /chat/completions。
# OpenAI 官方示例：https://api.openai.com/v1
# 第三方示例：https://your-provider.example/v1
# 本地模型示例：http://127.0.0.1:8000/v1（Docker 内需使用容器能访问的主机地址）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace_with_your_llm_api_key
# 按你的服务商实际提供的模型 ID 填写，不会自动替换模型。
LLM_MODEL=replace_with_your_model_id
# 本地免鉴权服务也填一个非空占位值，例如 local-unused。

# ===== 模型请求与判定 =====
# true：发送 response_format={"type":"json_object"}。
# 服务商不支持 JSON mode 时改为 false；仍要求模型输出 JSON 并严格校验。
LLM_JSON_MODE=true
LLM_TIMEOUT_SECONDS=30
LLM_CONCURRENCY=2
# 只有 is_ad=true、证据为待审原文且 confidence 达标，才执行踢人。
# confidence 是模型自评，不是经过统计校准的准确率。
AD_CONFIDENCE_THRESHOLD=0.90
# 可选额外请求参数。默认空，避免给不兼容的模型强加 temperature 等字段。
# 示例：LLM_EXTRA_BODY='{"temperature":0,"max_tokens":512}'
# 某些模型使用 max_completion_tokens 而非 max_tokens，按服务商文档设置。
LLM_EXTRA_BODY={}
GROUP_POLICY="禁止商业推广、拉客、诈骗和导流广告；允许正常讨论、求助、新闻引用和非推广性质的链接分享。"

# ===== 群管理行为 =====
# false：执行删除/踢人。true：仍请求模型，但只记录拟执行操作。
DRY_RUN=false
# kick：移出后解除封禁，允许重新加入；ban：永久封禁（仅超级群）。
KICK_MODE=kick
# 群主/管理员自动豁免踢人；下面可以额外填写免踢用户 ID。
EXEMPT_USER_IDS=
# false：只对已观察到入群事件的新成员计前三条。
# true：对首次观察到的老成员也计前三条。
CHECK_UNSEEN_MEMBERS=false
# 新人未完成三条文字审核时，删除图片/视频/语音/贴纸/文件等无法完整审核的媒体。
# 带说明文字也删除；不占前三条名额，不因媒体本身踢人，管理员/豁免用户除外。
# 三条文字均被模型判为非广告后放行媒体；排队或接口失败不算通过。
# false 恢复旧行为：媒体也占名额，只检查可提取的文字。
RESTRICT_NEWCOMER_MEDIA=true

# ===== 数据与失败重试 =====
# session、计数、待审内容和日志保存于此；请保留，重启后自动恢复。
# 从之前的纯 Bot API 示例切换：本版本使用新的 moderation.sqlite3。
DATA_DIR=./data
# 超过次数后保留为 failed 并记日志；修复后可用 --retry-failed 重新排队。
JOB_MAX_ATTEMPTS=8
JOB_RETRY_SECONDS=10

# ===== 可选代理 =====
# Telegram 使用独立代理，不读取 HTTPS_PROXY。
# 例：socks5://127.0.0.1:1080 或 http://user:password@host:port
TG_PROXY_URL=
# 模型 HTTP 请求的代理，空白表示直连；例：http://127.0.0.1:7890
LLM_PROXY_URL=
